{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Affiliate product details",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "affiliateLink": {
          "type": "string",
          "description": "Affiliate URL"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the product image"
        },
        "category": {
          "type": "string",
          "description": "Category of the product (Pintura, Desenho, Pirografia, Modelagem, or Entalhe/Escultura em Madeira)"
        },
        "order": {
          "type": "integer",
          "description": "Display sort order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "affiliateLink", "imageUrl"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Lead capture for the manual",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "email"]
    },
    "Arquivo": {
      "title": "Arquivo",
      "description": "Gallery work/media image addresses",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "img": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "category", "img"]
    },
    "EcomProduct": {
      "title": "EcomProduct",
      "description": "Store product for e-commerce",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "images": { "type": "array" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "width": { "type": "number" },
        "length": { "type": "number" },
        "stock": { "type": "integer" },
        "price": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "category", "images", "weight", "height", "width", "length", "stock", "price"]
    },
    "EcomOrder": {
      "title": "EcomOrder",
      "description": "Store order details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerInfo": { "type": "object" },
        "items": { "type": "array" },
        "shippingMethod": { "type": "string" },
        "shippingCost": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentId": { "type": "string" },
        "trackingCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "customerInfo", "items", "shippingMethod", "shippingCost", "subtotal", "total", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of affiliate products"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of captured leads"
    },
    "/arquivos/{arquivoId}": {
      "schema": "Arquivo",
      "description": "Collection of gallery works and images"
    },
    "/ecom_products/{productId}": {
      "schema": "EcomProduct",
      "description": "Collection of store products for purchase"
    },
    "/ecom_orders/{orderId}": {
      "schema": "EcomOrder",
      "description": "Collection of store orders and checkout details"
    }
  }
}
