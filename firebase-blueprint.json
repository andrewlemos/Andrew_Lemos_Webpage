{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Affiliate product details",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "affiliateLink": {
          "type": "string",
          "description": "Affiliate URL"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the product image"
        },
        "category": {
          "type": "string",
          "description": "Category of the product (Pintura, Desenho, Pirografia, Modelagem, or Entalhe/Escultura em Madeira)"
        },
        "order": {
          "type": "integer",
          "description": "Display sort order"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "affiliateLink", "imageUrl"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Lead capture for the manual",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "email"]
    },
    "Arquivo": {
      "title": "Arquivo",
      "description": "Gallery work/media image addresses",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "img": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "category", "img"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of affiliate products"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of captured leads"
    },
    "/arquivos/{arquivoId}": {
      "schema": "Arquivo",
      "description": "Collection of gallery works and images"
    }
  }
}
