# Exemplo de variáveis de ambiente do projeto.
# Configure as chaves reais em seu menu de Configurações (Settings -> Secrets) no AI Studio ou em seu arquivo .env local.

SMTP_USER=andrewfmlemos@gmail.com
SMTP_PASS=

# Mercado Pago API Access Token (Deixe em branco para utilizar o Simulador Virtual no ambiente de testes)
MERCADOPAGO_ACCESS_TOKEN=

# Melhor Envio API Integration (Calculadora de Fretes Oficial)
MELHORENVIO_TOKEN=
MELHORENVIO_FROM_CEP=13630000

# Firebase Admin SDK Credentials (Required for server-side security operations on Firestore / Vercel Deployments)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: You can paste the entire service account JSON string single line in FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT=

