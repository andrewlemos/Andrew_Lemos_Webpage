{
  "version": 2,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/blog",
      "destination": "/api/index.ts"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/index.ts"
    },
    {
      "source": "/vendas",
      "destination": "/api/index.ts"
    },
    {
      "source": "/vendas/:slug",
      "destination": "/api/index.ts"
    },
    {
      "source": "/galeria",
      "destination": "/api/index.ts"
    },
    {
      "source": "/galeria/:slug",
      "destination": "/api/index.ts"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
